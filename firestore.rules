rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in users (people you've added under Authentication → Users) can read or write jobs.
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
      match /doors/{doorId} {
        allow read, write: if request.auth != null;
        match /photos/{photoId} {
          allow read, write: if request.auth != null;
        }
      }
    }
  }
}
